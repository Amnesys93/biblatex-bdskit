\ProvidesFile{bdskit.bbx}[2026/08/07 BDS-like bibliography style]

\RequireBibliographyStyle{numeric-comp}

\DeclareNameAlias{default}{family-given}

\DeclareFieldFormat{title}{„#1“}
\DeclareFieldFormat{booktitle}{„#1“}
\DeclareFieldFormat{journaltitle}{„#1“}
\DeclareFieldFormat{publisher}{#1}
\DeclareFieldFormat{location}{#1}

\DeclareFieldFormat{year}{#1}

\DeclareFieldFormat{pages}{С.~#1}

\DeclareFieldFormat{url}{URL: \url{#1}}
\DeclareFieldFormat{doi}{DOI:~#1}

\renewbibmacro*{publisher+location+date}{%
  \printlist{publisher}%
  \setunit*{\addcomma\space}%
  \printlist{location}%
  \setunit*{\addcomma\space}%
  \printfield{year}%
}

\renewbibmacro*{title}{%
  \printfield{title}%
  \newunit
}

\renewbibmacro*{author}{%
  \printnames{author}%
  \newunit
}

\renewbibmacro*{finentry}{\finentry}
