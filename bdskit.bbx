\ProvidesFile{bdskit.bbx}[2026/09/25 BDS-like bibliography style]

% ============================================================
% Base bibliography style
% ============================================================

\RequireBibliographyStyle{numeric}

% ============================================================
% General options
% ============================================================

\ExecuteBibliographyOptions{
  sorting=none,
  maxnames=3,
  giveninits=true
}

% ============================================================
% Names
% ============================================================

\DeclareNameAlias{default}{family-given}

% ============================================================
% Titles
% ============================================================

% Print titles without quotation marks.
% Use \bibsentence to preserve normal interword spacing.

\DeclareFieldFormat
  [article,inbook,incollection,inproceedings,inreference,book,manual,misc,online,thesis,unpublished]
  {title}{#1}

\DeclareFieldFormat{journaltitle}{#1}
\DeclareFieldFormat{booktitle}{#1}

% ============================================================
% Volume / number
% ============================================================

\DeclareFieldFormat{volume}{#1}
\DeclareFieldFormat{number}{#1}

% ============================================================
% Pages
% ============================================================

\DeclareFieldFormat{pages}{С.~#1}

% ============================================================
% DOI
% ============================================================

\DeclareFieldFormat{doi}{DOI:\space\href{https://doi.org/#1}{#1}}

% ============================================================
% URL
% ============================================================

\DeclareFieldFormat{url}{URL:\space\url{#1}}

% ============================================================
% URL access date
% ============================================================

% The urldate field is printed automatically by the bdskit-url
% bibliography macro whenever an access date is present.
%
% Example:
%   URL: https://example.com, достъпен 25.09.2026.

\DeclareFieldFormat{urldate}{#1}

% ============================================================
% ISBN
% ============================================================

\DeclareFieldFormat{isbn}{ISBN:\space#1}

% ============================================================
% Date
% ============================================================

\DeclareFieldFormat{date}{#1}

% ============================================================
% Publisher / location / date
% ============================================================

\renewbibmacro*{publisher+location+date}{%
  \printlist{location}%
  \setunit{\addcomma\space}%
  \printlist{publisher}%
  \setunit{\addcomma\space}%
  \printdate%
}

% ============================================================
% Note
% ============================================================

\newbibmacro*{bdskit-note}{%
  \iffieldundef{note}
    {}
    {%
      \setunit{\addperiod\space}%
      \printfield{note}%
    }%
}

% ============================================================
% ISBN
% ============================================================

\newbibmacro*{bdskit-isbn}{%
  \iffieldundef{isbn}
    {}
    {%
      \setunit{\addperiod\space}%
      \printfield{isbn}%
    }%
}

% ============================================================
% DOI
% ============================================================

\newbibmacro*{bdskit-doi}{%
  \iffieldundef{doi}
    {}
    {%
      \setunit{\addperiod\space}%
      \printfield{doi}%
    }%
}

% ============================================================
% URL
% ============================================================

% Prints the URL and, if available, its access date.
%
% Expected output:
%   URL: https://example.com, достъпен 25.09.2026.

\newbibmacro*{bdskit-url}{%
  \iffieldundef{url}
    {}
    {%
      \setunit{\addperiod\space}%
      \printfield{url}%
      \iffieldundef{urldate}
        {}
        {%
          \setunit{\addcomma\space}%
          достъпен\space
          \printdate[urldate]%
        }%
    }%
}

% ============================================================
% Organization
% ============================================================

\newbibmacro*{bdskit-organization}{%
  \iffieldundef{organization}
    {}
    {%
      \setunit{\addperiod\space}%
      \printfield{organization}%
    }%
}

% ============================================================
% Article
% ============================================================

\DeclareBibliographyDriver{article}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printfield{journaltitle}%
  \setunit{\addcomma\space}%
  \printdate%
  \setunit{\addperiod\space}%
  \printfield{volume}%
  \iffieldundef{number}
    {}
    {%
      \setunit{\addcomma\space}%
      \printfield{number}%
    }%
  \iffieldundef{pages}
    {}
    {%
      \setunit{\addcomma\space}%
      \printfield{pages}%
    }%
  \usebibmacro{bdskit-doi}%
  \usebibmacro{bdskit-url}%
  \usebibmacro{finentry}%
}

% ============================================================
% Book
% ============================================================

\DeclareBibliographyDriver{book}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \usebibmacro{publisher+location+date}%
  \usebibmacro{bdskit-note}%
  \usebibmacro{bdskit-isbn}%
  \usebibmacro{bdskit-doi}%
  \usebibmacro{bdskit-url}%
  \usebibmacro{finentry}%
}

% ============================================================
% Inbook
% ============================================================

\DeclareBibliographyDriver{inbook}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printfield{booktitle}%
  \setunit{\addperiod\space}%
  \usebibmacro{publisher+location+date}%
  \iffieldundef{pages}
    {}
    {%
      \setunit{\addcomma\space}%
      \printfield{pages}%
    }%
  \usebibmacro{bdskit-doi}%
  \usebibmacro{bdskit-url}%
  \usebibmacro{finentry}%
}

% ============================================================
% Incollection
% ============================================================

\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printfield{booktitle}%
  \setunit{\addperiod\space}%
  \usebibmacro{publisher+location+date}%
  \iffieldundef{pages}
    {}
    {%
      \setunit{\addcomma\space}%
      \printfield{pages}%
    }%
  \usebibmacro{bdskit-doi}%
  \usebibmacro{bdskit-url}%
  \usebibmacro{finentry}%
}

% ============================================================
% Inproceedings
% ============================================================

\DeclareBibliographyDriver{inproceedings}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printfield{booktitle}%
  \setunit{\addperiod\space}%
  \usebibmacro{publisher+location+date}%
  \iffieldundef{pages}
    {}
    {%
      \setunit{\addcomma\space}%
      \printfield{pages}%
    }%
  \usebibmacro{bdskit-doi}%
  \usebibmacro{bdskit-url}%
  \usebibmacro{finentry}%
}

% ============================================================
% Online
% ============================================================

\DeclareBibliographyDriver{online}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printdate%
  \usebibmacro{bdskit-note}%
  \usebibmacro{bdskit-url}%
  \usebibmacro{finentry}%
}

% ============================================================
% Miscellaneous
% ============================================================

\DeclareBibliographyDriver{misc}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \iffieldundef{year}
    {}
    {%
      \setunit{\addperiod\space}%
      \printdate%
    }%
  \usebibmacro{bdskit-organization}%
  \usebibmacro{bdskit-note}%
  \usebibmacro{bdskit-url}%
  \usebibmacro{finentry}%
}

